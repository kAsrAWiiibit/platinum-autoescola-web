---
/** Barra fija en el móvil: WhatsApp (principal) y Llamar. Se esconde mientras se ven los botones de la portada. */
import type { Contenido } from '../data/contenido';
import { tel } from '../lib/contacto';
import Icono from './Icono.astro';

interface Props { c: Contenido }
const { c } = Astro.props;
---
<nav class="barra" aria-label={c.portada.whatsapp}>
  <a class="boton boton--wa" href={c.portada.whatsappUrl} target="_blank" rel="noopener" data-evento="whatsapp-barra">
    <Icono nombre="whatsapp" tam={22} />{c.barra.whatsapp}<span class="visualmente-oculto"> {c.barra.abre}</span>
  </a>
  <a class="boton boton--blanco" href={tel} aria-label={c.portada.llamarEtiqueta} data-evento="llamar-barra">
    <Icono nombre="phone" tam={20} />{c.barra.llamar}
  </a>
</nav>

<script>
  // Mientras se ven los botones de la portada, la barra sobra: se esconde (con transform, sin mover nada)
  const barra = document.querySelector<HTMLElement>('.barra');
  const botones = document.querySelector('[data-botones-portada]');
  if (barra && botones && 'IntersectionObserver' in window) {
    new IntersectionObserver(([v]) => barra.classList.toggle('barra--oculta', v.isIntersecting)).observe(botones);
  }
</script>

<style>
  .barra {
    position: fixed; inset: auto 0 0 0; z-index: 50;
    display: grid; grid-template-columns: 1.35fr 1fr; gap: 8px;
    padding: 10px 12px calc(10px + env(safe-area-inset-bottom));
    background: var(--marino);
    transition: transform 320ms var(--salida);
  }
  .barra .boton { min-height: 56px; padding-inline: 12px; }
  .barra--oculta { transform: translateY(110%); }
  @media (min-width: 900px) { .barra { display: none; } }
  @media (prefers-reduced-motion: reduce) { .barra { transition: none; } }
</style>
