---
/**
 * Iconos: marcas de simple-icons (WhatsApp, Instagram, Google) y trazos de lucide, los dos leídos en la build
 * (no llega ninguna librería al navegador).
 */
import { siGoogle, siInstagram, siWhatsapp } from 'simple-icons';
import { readFileSync } from 'node:fs';
import { createRequire } from 'node:module';

type Marca = 'whatsapp' | 'instagram' | 'google';
type Trazo = 'phone' | 'map-pin' | 'arrow-up-right' | 'arrow-right' | 'navigation' | 'clock' | 'mail' | 'chevron-down';
interface Props { nombre: Marca | Trazo; class?: string; tam?: number }
const { nombre, class: clase, tam = 20 } = Astro.props;

const marcas: Record<Marca, string> = { whatsapp: siWhatsapp.path, instagram: siInstagram.path, google: siGoogle.path };
const req = createRequire(import.meta.url);
const interior = (n: Trazo) =>
  readFileSync(req.resolve(`lucide-static/icons/${n}.svg`), 'utf8')
    .replace(/^[\s\S]*?<svg[^>]*>/, '')
    .replace(/<\/svg>\s*$/, '');
const esMarca = nombre in marcas;
---
{esMarca ? (
  <svg class:list={['icono', clase]} width={tam} height={tam} viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="currentColor"><path d={marcas[nombre as Marca]} /></svg>
) : (
  <svg class:list={['icono', clase]} width={tam} height={tam} viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={interior(nombre as Trazo)} />
)}
