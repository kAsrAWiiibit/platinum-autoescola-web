---
/**
 * Los tres permisos en tarjetas comparables: precio, qué incluye, requisito y un botón a WhatsApp con el
 * mensaje del permiso. Cada tarjeta, un color plano; la franja de abajo, más oscura, es el botón.
 */
import type { Contenido } from '../data/contenido';
import Anillo from './Anillo.astro';
import Icono from './Icono.astro';

interface Props { c: Contenido }
const { c } = Astro.props;
const p = c.permisos;
---
<section id="permisos" class="seccion permisos" aria-labelledby="titulo-permisos">
  <div class="contenedor">
    <div class="permisos__cabeza revela">
      <h2 id="titulo-permisos">{p.titulo}</h2>
      <p class="entradilla">{p.entradilla}</p>
    </div>
    <ul class="permisos__lista revela">
      {p.lista.map((x, i) => (
        <li id={`permiso-${x.id.toLowerCase()}`} class:list={['tarjeta', `tarjeta--${i}`]}>
          <div class="tarjeta__cuerpo">
            <h3 class="tarjeta__id"><span aria-hidden="true">{x.id}</span><span class="visualmente-oculto">{x.nombre}</span></h3>
            <p class="tarjeta__precio"><span class="visualmente-oculto">{p.precioEtiqueta}: </span>{x.precio}</p>
            <p class="tarjeta__nota">{x.vehiculo} · {x.notaPrecio}</p>
            <dl class="tarjeta__datos">
              <div>
                <dt>{p.requisitoTitulo}</dt>
                <dd>{x.requisito}{x.examen && <><br />{x.examen}</>}</dd>
              </div>
              <div>
                <dt>{p.incluyeTitulo}</dt>
                <dd>
                  <ul class="tarjeta__incluye">
                    {x.incluye.map((linea) => <li><Anillo class="vineta" grosor={26} />{linea}</li>)}
                  </ul>
                </dd>
              </div>
            </dl>
          </div>
          <a class="tarjeta__boton" href={x.whatsapp} target="_blank" rel="noopener" data-evento={`whatsapp-${x.id}`}>
            <Icono nombre="whatsapp" tam={22} />
            <span>{x.boton}<span class="visualmente-oculto"> {c.barra.abre}</span></span>
            <Icono nombre="arrow-up-right" tam={20} class="tarjeta__flecha" />
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .permisos__cabeza { display: grid; gap: 16px; margin-bottom: clamp(32px, 5vw, 56px); }
  .permisos__cabeza .entradilla { color: var(--tinta-suave); }
  .permisos__lista { display: grid; gap: 10px; }
  .tarjeta {
    --fondo: var(--azul); --franja: var(--azul-oscuro); --texto: var(--blanco); --suave: #d6e3ef;
    display: flex; flex-direction: column; border-radius: var(--radio); overflow: hidden;
    background: var(--fondo); color: var(--texto); scroll-margin-top: 16px;
  }
  .tarjeta--1 { --fondo: var(--marino-2); --franja: var(--marino); --suave: var(--suave-oscuro); }
  .tarjeta--2 { --fondo: var(--platino); --franja: var(--platino-2); --texto: var(--tinta); --suave: var(--tinta-suave); }
  .tarjeta__cuerpo { flex: 1; padding: clamp(22px, 3vw, 32px); display: flex; flex-direction: column; }
  .tarjeta__id { font-size: clamp(4.5rem, 3.5rem + 4vw, 7rem); font-stretch: 125%; letter-spacing: -0.04em; line-height: 0.85; }
  .tarjeta__precio {
    margin-top: 20px; font-weight: 800; font-stretch: 112%; letter-spacing: -0.03em; line-height: 1;
    font-size: clamp(2.5rem, 2.1rem + 1.6vw, 3.5rem); font-variant-numeric: tabular-nums;
  }
  .tarjeta__nota { margin-top: 8px; font-size: var(--paso-pequeno); font-weight: 600; color: var(--suave); }
  .tarjeta__datos { display: grid; gap: 20px; margin-top: 28px; }
  dt { font-size: var(--paso-pequeno); font-weight: 700; color: var(--suave); margin-bottom: 6px; }
  dd { margin: 0; }
  .tarjeta__incluye { display: grid; gap: 6px; }
  .tarjeta__incluye li { display: grid; grid-template-columns: 14px 1fr; gap: 10px; align-items: start; line-height: 1.4; }
  .tarjeta__incluye :global(.vineta) { width: 12px; margin-top: 0.38em; }
  .tarjeta__boton {
    display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 12px;
    min-height: 68px; padding: 14px clamp(22px, 3vw, 32px);
    background: var(--franja); color: inherit; font-weight: 700; font-stretch: 105%; text-decoration: none; line-height: 1.2;
    transition: background-color 180ms var(--salida);
  }
  .tarjeta__boton :global(.icono:first-child) { color: var(--wa); }
  .tarjeta--2 .tarjeta__boton :global(.icono:first-child) { color: #128c4b; }
  .tarjeta__boton:hover { background: color-mix(in srgb, var(--franja) 82%, #000); }
  .tarjeta--2 .tarjeta__boton:hover { background: #b6bfcc; }
  .tarjeta__boton :global(.tarjeta__flecha) { transition: transform 200ms var(--salida); }
  .tarjeta__boton:hover :global(.tarjeta__flecha) { transform: translate(2px, -2px); }

  @media (min-width: 900px) {
    .permisos__cabeza { grid-template-columns: 1.3fr 1fr; align-items: end; }
    .permisos__lista { grid-template-columns: repeat(3, 1fr); }
  }
</style>
