---
/**
 * Cómo funciona: un solo diagrama. El anillo del logo partido en cuatro cuartos, uno por paso, que se van
 * completando en orden (matrícula → teórico → prácticas → examen); al lado, los pasos en tipo grande.
 */
import type { Contenido } from '../data/contenido';

interface Props { c: Contenido }
const { c } = Astro.props;
const p = c.pasos;
const r = 40;
const circ = 2 * Math.PI * r;
const hueco = 3.2;
const cuarto = circ / 4 - hueco;
---
<section id="como-funciona" class="seccion pasos oscuro" aria-labelledby="titulo-pasos">
  <div class="contenedor pasos__rejilla">
    <div class="pasos__cabeza revela">
      <h2 id="titulo-pasos">{p.titulo}</h2>
      <p class="entradilla">{p.entradilla}</p>
    </div>

    <svg class="pasos__anillo" viewBox="0 0 100 100" aria-hidden="true" data-anillo>
      {p.lista.map((_, i) => (
        <g>
          <circle
            class="cuarto" style={`--n: ${i}`}
            cx="50" cy="50" r={r} fill="none" stroke-width="16"
            stroke-dasharray={`${cuarto} ${circ}`}
            transform={`rotate(${-90 + i * 90 + (hueco / circ) * 180} 50 50)`}
          />
          <text
            x={50 + (r - 0) * Math.cos(((-45 + i * 90) * Math.PI) / 180)}
            y={50 + (r - 0) * Math.sin(((-45 + i * 90) * Math.PI) / 180)}
            text-anchor="middle" dominant-baseline="central"
          >{i + 1}</text>
        </g>
      ))}
    </svg>

    <ol class="pasos__lista revela">
      {p.lista.map((paso, i) => (
        <li class="paso">
          <span class="paso__n" aria-hidden="true">{i + 1}</span>
          <div>
            <h3>{paso.nombre}</h3>
            <p>{paso.texto}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<script>
  // El anillo se completa cuarto a cuarto cuando aparece (sin movimiento reducido)
  const anillo = document.querySelector<SVGElement>('[data-anillo]');
  if (anillo && 'IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    anillo.classList.add('pasos__anillo--espera');
    const o = new IntersectionObserver(([v]) => {
      if (!v.isIntersecting) return;
      anillo.classList.remove('pasos__anillo--espera');
      o.disconnect();
    }, { threshold: 0.4 });
    o.observe(anillo);
  }
</script>

<style>
  .pasos__rejilla { display: grid; gap: 40px; }
  .pasos__cabeza { display: grid; gap: 16px; }
  .pasos__anillo { width: min(240px, 62vw); justify-self: start; overflow: visible; }
  .cuarto {
    stroke: var(--platino);
    opacity: calc(0.55 + var(--n) * 0.15);
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 700ms var(--salida), opacity 700ms var(--salida);
    transition-delay: calc(var(--n) * 260ms);
  }
  .pasos__anillo--espera .cuarto { stroke-dashoffset: 60; opacity: 0; }
  .pasos__anillo text { fill: var(--marino); font: 800 8px var(--fuente); font-stretch: 118%; }
  .pasos__lista { display: grid; gap: 28px; }
  .paso { display: grid; grid-template-columns: 2.25rem 1fr; gap: 14px; }
  .paso__n { font-weight: 800; font-stretch: 125%; font-size: 1.75rem; line-height: 1; color: var(--platino); }
  .paso h3 { font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.25rem); }
  .paso p { margin-top: 8px; color: var(--suave-oscuro); max-width: 46ch; }
  @media (min-width: 900px) {
    .pasos__rejilla { grid-template-columns: 5fr 7fr; column-gap: 64px; row-gap: 56px; }
    .pasos__cabeza { grid-column: 1 / -1; grid-template-columns: 1.3fr 1fr; align-items: end; }
    .pasos__anillo { width: 100%; max-width: 420px; position: sticky; top: 48px; }
    .pasos__lista { gap: 40px; }
    .paso { grid-template-columns: 3.5rem 1fr; }
    .paso__n { font-size: 2.5rem; }
  }
  @media (prefers-reduced-motion: reduce) { .cuarto { transition: none; } }
</style>
