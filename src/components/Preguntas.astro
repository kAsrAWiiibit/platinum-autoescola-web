---
/** Preguntas frecuentes: respuestas sacadas solo de los datos del cliente. Una abierta cada vez. */
import type { Contenido } from '../data/contenido';
import { completo } from '../lib/pendiente';
import Dato from './Dato.astro';
import SiCompleto from './SiCompleto.astro';

interface Props { c: Contenido }
const { c } = Astro.props;
const p = c.preguntas;
---
<section id="preguntas" class="seccion preguntas" aria-labelledby="titulo-preguntas">
  <div class="contenedor preguntas__rejilla">
    <h2 id="titulo-preguntas" class="revela">{p.titulo}</h2>
    <div class="preguntas__lista revela">
      {p.lista.map((x) => (
        <details name="preguntas">
          <summary><span>{x.pregunta}</span><span class="mas" aria-hidden="true"></span></summary>
          <p>{x.respuesta}</p>
        </details>
      ))}
      <SiCompleto datos={[c.plazos.respuesta]} donde="Preguntas: pago a plazos">
        <details name="preguntas">
          <summary><span>{c.plazos.pregunta}</span><span class="mas" aria-hidden="true"></span></summary>
          <p><Dato v={completo(c.plazos.respuesta) ? c.plazos.respuesta : c.plazos.respuesta} donde="pago a plazos" /></p>
        </details>
      </SiCompleto>
    </div>
  </div>
</section>

<style>
  .preguntas__rejilla { display: grid; gap: 32px; }
  .preguntas__lista { display: grid; gap: 8px; }
  details { border-radius: var(--radio); background: var(--blanco); transition: background-color 200ms var(--salida), color 200ms var(--salida); }
  details[open] { background: var(--marino); color: var(--blanco); }
  summary {
    display: flex; justify-content: space-between; align-items: center; gap: 20px;
    min-height: 68px; padding: 18px 22px; cursor: pointer; list-style: none;
    font-weight: 600; font-size: 1.0625rem; line-height: 1.3;
  }
  summary::-webkit-details-marker { display: none; }
  .mas { position: relative; flex: none; width: 18px; height: 18px; }
  .mas::before, .mas::after {
    content: ''; position: absolute; left: 0; top: 7.5px; width: 18px; height: 3px; border-radius: 2px; background: currentColor;
    transition: transform 240ms var(--salida);
  }
  .mas::after { transform: rotate(90deg); }
  details[open] .mas::after { transform: rotate(0deg); }
  details p { padding: 0 22px 22px; max-width: 60ch; }
  details[open] p { color: var(--suave-oscuro); }
  details::details-content { block-size: 0; overflow: clip; transition: block-size 280ms var(--salida), content-visibility 280ms allow-discrete; }
  details[open]::details-content { block-size: auto; }
  @supports (interpolate-size: allow-keywords) { :root { interpolate-size: allow-keywords; } }
  @media (min-width: 900px) {
    .preguntas__rejilla { grid-template-columns: 4fr 8fr; gap: 48px; align-items: start; }
    #titulo-preguntas { position: sticky; top: 32px; }
    summary { font-size: 1.1875rem; padding: 20px 28px; min-height: 76px; }
    details p { padding: 0 28px 26px; }
  }
  @media (prefers-reduced-motion: reduce) {
    details, .mas::before, .mas::after, details::details-content { transition: none; }
  }
</style>
