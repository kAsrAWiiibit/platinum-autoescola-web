---
import '../styles/global.css';
// La única fuente (Archivo variable, latín), precargada para que el texto de la portada no salte
import fuente from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';

import BarraContacto from '../components/BarraContacto.astro';
import Pie from '../components/Pie.astro';
import { contenido } from '../data/contenido';
import { negocio, permisos, precio } from '../data/negocio.mjs';
import { SIN_INDEXAR, VISTA_PREVIA } from '../data/sitio.mjs';
import { PAGINAS, enlace, type Pagina } from '../lib/rutas';
import { IDIOMAS, type Idioma } from '../lib/textos';

interface Props {
  titulo: string;
  descripcion: string;
  idioma: Idioma;
  pagina?: Pagina;
  /** Datos estructurados de la autoescuela (solo la portada) */
  datosNegocio?: boolean;
  /** Fuera de buscadores aunque la web se indexe (la 404) */
  indexar?: boolean;
}
const { titulo, descripcion, idioma, pagina, datosNegocio = false } = Astro.props;
const c = contenido(idioma);
const indexar = Astro.props.indexar !== false && !SIN_INDEXAR;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const absoluta = (ruta: string) => (Astro.site ? new URL(ruta, Astro.site).href : ruta);
const canonica = Astro.site ? absoluta(Astro.url.pathname) : undefined;
const imagen = absoluta(`${base}/compartir.png`);
const alternas = pagina ? IDIOMAS.map((i) => ({ idioma: i, href: absoluta(enlace(pagina, i)) })) : [];
const otroIdioma: Idioma = idioma === 'es' ? 'ca' : 'es';

const datos = datosNegocio && {
  '@context': 'https://schema.org',
  '@type': 'DrivingSchool',
  name: negocio.nombre,
  url: absoluta(enlace('inicio', idioma)),
  image: imagen,
  logo: absoluta(`${base}/apple-touch-icon.png`),
  telephone: negocio.telefono.e164,
  email: negocio.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: negocio.direccion.calle,
    postalCode: negocio.direccion.cp,
    addressLocality: negocio.direccion.ciudad,
    addressRegion: negocio.direccion.provincia,
    addressCountry: negocio.direccion.pais,
  },
  areaServed: negocio.ciudad,
  priceRange: `${precio(Math.min(...permisos.map((p) => p.precio)))} – ${precio(Math.max(...permisos.map((p) => p.precio)))}`,
  sameAs: [negocio.instagram.url],
  makesOffer: c.permisos.lista.map((p) => ({
    '@type': 'Offer',
    name: p.nombre,
    price: permisos.find((x) => x.id === p.id)!.precio.toFixed(2),
    priceCurrency: 'EUR',
  })),
};
---
<!doctype html>
<html lang={idioma}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{titulo}</title>
    <link rel="preload" href={fuente} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={`@font-face{font-family:'Archivo';font-style:normal;font-display:swap;font-weight:100 900;font-stretch:62% 125%;src:url(${fuente}) format('woff2-variations');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}`} />
    <meta name="description" content={descripcion} />
    {canonica && <link rel="canonical" href={canonica} />}
    {alternas.map((a) => <link rel="alternate" hreflang={a.idioma} href={a.href} />)}
    {pagina && <link rel="alternate" hreflang="x-default" href={absoluta(enlace(pagina, 'es'))} />}
    <meta name="theme-color" content="#111936" />
    {!indexar && <meta name="robots" content={VISTA_PREVIA ? 'noindex, nofollow' : 'noindex'} />}
    <link rel="icon" href={`${base}/favicon.png`} type="image/png" />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={negocio.nombre} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    {canonica && <meta property="og:url" content={canonica} />}
    <meta property="og:image" content={imagen} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={titulo} />
    <meta property="og:locale" content={idioma === 'es' ? 'es_ES' : 'ca_ES'} />
    <meta property="og:locale:alternate" content={idioma === 'es' ? 'ca_ES' : 'es_ES'} />
    <meta name="twitter:card" content="summary_large_image" />
    {datos && <script type="application/ld+json" set:html={JSON.stringify(datos)} />}
  </head>
  <body>
    <a class="saltar" href="#contenido">{c.sitio.saltar}</a>
    <slot name="cabecera" />
    <main id="contenido">
      <slot />
    </main>
    <Pie c={c} otroIdioma={otroIdioma} pagina={pagina ?? 'inicio'} />
    <BarraContacto c={c} />

    <script>
      // Entradas: las partes de cada sección marcada con .revela suben y aparecen, en orden y una sola vez.
      // Sin este script (o con movimiento reducido) todo se ve desde el principio.
      if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const bloques = document.querySelectorAll<HTMLElement>('.revela');
        const observador = new IntersectionObserver(
          (vistas) => {
            for (const v of vistas) {
              if (!v.isIntersecting) continue;
              v.target.classList.add('visto');
              observador.unobserve(v.target);
            }
          },
          { rootMargin: '0px 0px -8% 0px' },
        );
        for (const b of bloques) {
          b.querySelectorAll<HTMLElement>(':scope > *').forEach((el, i) => el.style.setProperty('--i', String(Math.min(i, 5))));
          observador.observe(b);
        }
        document.documentElement.classList.add('mov');
      }
    </script>
  </body>
</html>
